#!/bin/sh
# Settle on one live display before any user session starts, and make video and
# audio both follow it.
#
# HDMI is the only connector that can be asked: a TV encoder has no detect line
# and its connector always reads connected. So HDMI plugged in means HDMI, and
# anything else means composite. The losing connector is forced off rather than
# merely deprioritised - left enabled it is a second output for every compositor
# to drive, at a refresh rate that beats against the real one.
#
# Read once at boot. A cable moved afterwards is not followed; set RK35XX_OUTPUT
# to hdmi or tv in the unit to override the detection entirely.
set -u

CONF=/etc/wireplumber/wireplumber.conf.d/60-rk35xx-sink-priority.conf
GAIN=${RK35XX_LINEOUT_GAIN:-80%}
WANT=${RK35XX_OUTPUT:-auto}

first() { for f in $1; do [ -e "$f" ] && { echo "${f%/status}"; return; }; done; }

HDMI=$(first '/sys/class/drm/card*-HDMI-A-*/status')
TV=$(first '/sys/class/drm/card*-TV-*/status')

if [ "$WANT" = auto ]; then
	WANT=tv
	[ -n "$HDMI" ] && [ "$(cat "$HDMI/status")" = connected ] && WANT=hdmi
fi

case "$WANT" in
hdmi) live=$HDMI; dead=$TV;   hdmi_prio=2000; analog_prio=1000 ;;
*)    live=$TV;   dead=$HDMI; hdmi_prio=1000; analog_prio=2000 ;;
esac

[ -n "$live" ] || dead=          # never park the only connector a board has
[ -n "$dead" ] && echo off > "$dead/status"
[ -n "$live" ] && echo detect > "$live/status"
echo "rk35xx-output-select: ${WANT}${dead:+, ${dead##*/} forced off}"

mkdir -p "${CONF%/*}"
cat > "$CONF" <<EOF2
# Generated by rk35xx-output-select. Edits are overwritten on the next boot.
monitor.alsa.rules = [
  { matches = [ { node.name = "~alsa_output.platform-hdmi-sound.*" } ]
    actions = { update-props = { priority.session = $hdmi_prio } } }
  { matches = [ { node.name = "~alsa_output.platform-acodec-sound.*" } ]
    actions = { update-props = { priority.session = $analog_prio } } }
  { matches = [ { node.name = "~alsa_output.platform-spdif-sound.*" } ]
    actions = { update-props = { priority.session = 500 } } }
]
EOF2

# The analog level is a hardware gain with no default worth having: both controls
# come up near minimum and the driver offers nothing else.
for c in 'DAC LEFT LINEOUT' 'DAC RIGHT LINEOUT'; do
	amixer -c rk3528acodec sset "$c" "$GAIN" > /dev/null 2>&1 || true
done
