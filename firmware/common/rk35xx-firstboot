#!/bin/sh
# Family first boot: board prep, hold the u-boot package (its postinst flashes ROCK-2F loaders =
# soft-brick), then build any staged DKMS source the image did not already carry.
set -e

# first: the board may have to remove a DKMS package that conflicts with an in-tree driver, and the
# loop below would otherwise build it
if [ -x /usr/local/sbin/rk35xx-firstboot-board ]; then
  /usr/local/sbin/rk35xx-firstboot-board
fi

ub=$(dpkg-query -W -f='${Package}\n' 'linux-u-boot-*' 2>/dev/null | head -1)
[ -n "$ub" ] && apt-mark hold "$ub" >/dev/null 2>&1 || true

# normally a no-op: build-image.sh built these into the image
/usr/local/sbin/rk35xx-dkms-build
systemctl restart systemd-modules-load 2>/dev/null || true

# udev reads only the compiled hwdb.bin, and only a board shipping a keymap has one to compile
if [ -n "$(ls -A /etc/udev/hwdb.d 2>/dev/null)" ]; then
  systemd-hwdb update || true
  udevadm control --reload || true                  # udevd caches the compiled hwdb
  udevadm trigger --subsystem-match=input || true   # the remote enumerated before the keymap existed
fi

# interfaces whose driver was just built did not exist when mac-pin ran at boot. Call the script,
# not the unit: a blocking systemctl job from inside first boot can stall on ordering.
[ -x /usr/local/sbin/rk35xx-mac-pin ] && /usr/local/sbin/rk35xx-mac-pin || true
