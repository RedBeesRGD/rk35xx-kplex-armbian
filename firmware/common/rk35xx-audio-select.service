[Unit]
# The generated drop-in has to exist before the session's wireplumber reads it
Description=rk35xx audio sink ranking for the live display
After=alsa-restore.service sound.target
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rk35xx-audio-select
# Environment=RK35XX_LINEOUT_GAIN=70%

[Install]
WantedBy=multi-user.target
