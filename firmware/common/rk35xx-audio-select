#!/bin/sh
# Rank the audio sinks to match the live display, before any user session starts.
# A TV encoder has no detect line and its connector always reads connected, so the
# HDMI connector is the only one that can be asked. Read once at boot: a cable
# moved afterwards is not followed.
set -u

CONF=/etc/wireplumber/wireplumber.conf.d/60-rk35xx-sink-priority.conf
GAIN=${RK35XX_LINEOUT_GAIN:-80%}

case "$(cat /sys/class/drm/card*-HDMI-A-*/status 2>/dev/null | head -n1)" in
connected) hdmi=2000; analog=1000 ;;
*) hdmi=1000; analog=2000 ;;
esac

mkdir -p "${CONF%/*}"
cat > "$CONF" <<EOF
# Generated by rk35xx-audio-select. Edits are overwritten on the next boot.
monitor.alsa.rules = [
  { matches = [ { node.name = "~alsa_output.platform-hdmi-sound.*" } ]
    actions = { update-props = { priority.session = $hdmi } } }
  { matches = [ { node.name = "~alsa_output.platform-acodec-sound.*" } ]
    actions = { update-props = { priority.session = $analog } } }
  { matches = [ { node.name = "~alsa_output.platform-spdif-sound.*" } ]
    actions = { update-props = { priority.session = 500 } } }
]
EOF

# The analog level is a hardware gain with no default worth having: both controls
# come up near minimum and the driver offers nothing else.
for c in 'DAC LEFT LINEOUT' 'DAC RIGHT LINEOUT'; do
	amixer -c rk3528acodec sset "$c" "$GAIN" > /dev/null 2>&1 || true
done
