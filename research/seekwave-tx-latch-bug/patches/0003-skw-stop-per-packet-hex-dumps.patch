From 4e1a90c7b2d5386f1c4a0e97d2b6153fa8c04e29 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Tue, 25 Aug 2026 20:30:00 -0400
Subject: [PATCH] skw: stop per-packet hex dumps bypassing the dump log control

skw_hex_dump() takes a "force" flag that skips the SKW_DUMP check:

	if ((skw_log_level() & SKW_DUMP) || force)

Five per-packet sites pass true, so they dump regardless of the setting. On an
idle station this fills the kernel log: 1659 of 1678 driver lines over two days
were "short skb" from skw_ndo_start_xmit(), while /proc/skwifid/log_level
reported "dump log: disable".

Pass false so the existing control applies. The dumps are still available by
enabling dump logging. Sites left alone are bounded: one at wiphy init and
three reached only from private ioctls.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 drivers/swt6621s_wifi/skw_core.c | 2 +-
 drivers/swt6621s_wifi/skw_edma.c | 2 +-
 drivers/swt6621s_wifi/skw_rx.c   | 4 ++--
 drivers/swt6621s_wifi/skw_tx.c   | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/swt6621s_wifi/skw_core.c b/drivers/swt6621s_wifi/skw_core.c
index e085fdc..eb5082a 100644
--- a/drivers/swt6621s_wifi/skw_core.c
+++ b/drivers/swt6621s_wifi/skw_core.c
@@ -342,7 +342,7 @@ static netdev_tx_t skw_ndo_xmit(struct sk_buff *skb, struct net_device *dev)
 	/* Mini frame size that HW support */
 	if (unlikely(skb->len <= 16)) {
 		skw_dev_dbg(dev, "current: %s\n", current->comm);
-		skw_hex_dump("short skb", skb->data, skb->len, true);
+		skw_hex_dump("short skb", skb->data, skb->len, false);
 
 		if (skb->len != ETH_HLEN || eth->h_proto != htons(ETH_P_IP))
 			SKW_BUG_ON(1);
diff --git a/drivers/swt6621s_wifi/skw_edma.c b/drivers/swt6621s_wifi/skw_edma.c
index 8bc8eb9..30a31a1 100644
--- a/drivers/swt6621s_wifi/skw_edma.c
+++ b/drivers/swt6621s_wifi/skw_edma.c
@@ -767,7 +767,7 @@ static void skw_pci_edma_rx_data(struct skw_edma_chn *edma_chn, void *data, int
 
 			skw_warn("total len: %d\n", total_len);
 			skw_warn("rxc node address:%llx skb->data:%llx\n", virt_to_phys(data), virt_to_phys(skb->data));
-			skw_hex_dump("invalid rx skb:", skb->data, skb->len, true);
+			skw_hex_dump("invalid rx skb:", skb->data, skb->len, false);
 
 			//skw_compat_page_frag_free((void *)p_data);
 			//kfree_skb(skb);
diff --git a/drivers/swt6621s_wifi/skw_rx.c b/drivers/swt6621s_wifi/skw_rx.c
index 9bd83f3..265ff8a 100644
--- a/drivers/swt6621s_wifi/skw_rx.c
+++ b/drivers/swt6621s_wifi/skw_rx.c
@@ -1150,7 +1150,7 @@ static void skw_ampdu_reorder(struct skw_core *skw, struct skw_rx_desc *desc,
 		if (desc->amsdu_first_idx &&
 		    ether_addr_equal(skb->data, snap_hdr)) {
 			cb->amsdu_flags |= SKW_AMSDU_FLAG_TAINT;
-			skw_hex_dump("attack", skb->data, 14, true);
+			skw_hex_dump("attack", skb->data, 14, false);
 		}
 
 		if (desc->amsdu_last_idx) {
@@ -1295,7 +1295,7 @@ static void skw_rx_handler_drop_info(struct skw_core *skw, struct sk_buff *pskb,
 				skw->hw.rx_desc.msdu_offset -
 				skw->hw.rx_desc.hdr_offset;
 		if (printk_timed_ratelimit(&j, 5000))
-			skw_hex_dump("dump", pskb->data - msdu_offset, pskb->len+msdu_offset, true);
+			skw_hex_dump("dump", pskb->data - msdu_offset, pskb->len+msdu_offset, false);
 		// skw_hw_assert(skw, false);
 		return;
 	}
diff --git a/drivers/swt6621s_wifi/skw_tx.c b/drivers/swt6621s_wifi/skw_tx.c
index 5a20b14..d196d62 100644
--- a/drivers/swt6621s_wifi/skw_tx.c
+++ b/drivers/swt6621s_wifi/skw_tx.c
@@ -1130,7 +1130,7 @@ void skw_dump_vring(struct vring *vr)
 
 		skw_dbg("    Desc[%03u]: addr=0x%016llx, len=%u, flags=0x%04x, next=%u\n",
 				i, (unsigned long long)desc->addr, desc->len, desc->flags, desc->next);
-		skw_hex_dump("desc addr", phys_to_virt(desc->addr), desc->len, true);
+		skw_hex_dump("desc addr", phys_to_virt(desc->addr), desc->len, false);
 	}
 
 	skw_dbg("  Available Ring (avail->idx=%u):\n", avail_idx);
-- 
