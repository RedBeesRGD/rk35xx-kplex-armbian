From d95ff53bc6f69d18b17067abe43911f447288b61 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sun, 6 Sep 2026 21:23:49 -0400
Subject: [PATCH] skw: let Bluetooth wake the host from suspend

hci_suspend_sync() disconnects every link on the way into suspend and then
decides whether to arm a wake path:

	if (!hdev->wakeup || !hdev->wakeup(hdev)) {
		hdev->suspend_state = BT_SUSPEND_DISCONNECT;
		return 0;
	}

This driver never sets hdev->wakeup, so that early return is always taken.
No event filter is installed and the LE accept list is never programmed, so
the controller has nothing to wake on and the remote it has just
disconnected cannot bring the host back.

The same omission shows up in userspace: hci_register_dev() only adds
HCI_CONN_FLAG_REMOTE_WAKEUP to hdev->conn_flags when the driver supplies the
callback, so BlueZ never exposes WakeAllowed on a paired device and there is
no way to mark a remote as a wake source in the first place.

Supply the callback, gated on device_may_wakeup() of the parent platform
device so the sysfs power/wakeup toggle still disables it, and pair it with
device_init_wakeup() to create that attribute.

hdev->wakeup appeared in 5.16, so the whole thing is version-gated to keep
the out-of-tree build working on older kernels.

On an H96 Max 3518D (RK3528, SWT6621S over SDIO) the platform host-wake GPIO
is already armed as a system wake source by the SDIO core's enable_irq_wake(),
so this callback was the remaining gap on the host side.
---
 drivers/swtbt4l/skw_btdriver.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/swtbt4l/skw_btdriver.c b/drivers/swtbt4l/skw_btdriver.c
index 4e03e5e..5fc9e72 100755
--- a/drivers/swtbt4l/skw_btdriver.c
+++ b/drivers/swtbt4l/skw_btdriver.c
@@ -984,6 +984,16 @@ int btseekwave_plt_event_notifier(struct notifier_block *nb, unsigned long actio
     return NOTIFY_OK;
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+/* Without this the core takes the !hdev->wakeup branch in hci_suspend_sync(), stopping after it
+ * has disconnected everything: no event filter, no accept list, so nothing can wake the host.
+ */
+static bool btseekwave_wakeup(struct hci_dev *hdev)
+{
+    return hdev->dev.parent && device_may_wakeup(hdev->dev.parent);
+}
+#endif
+
 static int btseekwave_probe(struct platform_device *pdev)
 {
     struct btseekwave_data *data;
@@ -1040,6 +1050,10 @@ static int btseekwave_probe(struct platform_device *pdev)
     hdev->send     = btseekwave_send_frame_lv;
 #endif
     hdev->setup    = btseekwave_setup;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+    device_init_wakeup(dev, true);
+    hdev->wakeup   = btseekwave_wakeup;
+#endif
 
     atomic_set(&hdev->promisc, 0);
 
@@ -1049,6 +1063,9 @@ static int btseekwave_probe(struct platform_device *pdev)
     err = hci_register_dev(hdev);
     if (err < 0)
     {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+        device_init_wakeup(dev, false);
+#endif
         hci_free_dev(hdev);
         return err;
     }
@@ -1116,6 +1133,10 @@ static int btseekwave_remove(struct platform_device *pdev)
 
         hci_free_dev(hdev);
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+        device_init_wakeup(&pdev->dev, false);
+#endif
+
 #if SKWBT_LOG_PORT_EN
         skwbt_log_port_exit();
 #endif
-- 
