From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Wed, 9 Sep 2026 21:00:00 -0400
Subject: [PATCH] skw: optional quirk to keep the bluetooth link across suspend

A paired BLE remote cannot wake this board through the upstream path.
hci_suspend_sync() disconnects every link on the way into suspend, and
this handset answers roughly three seconds later with ADV_DIRECT_IND to
reconnect. Waking on an accept-listed device's advert is the design, and
it cannot be filtered, because a keypress from a bonded remote produces
the same PDU. The box never stays asleep longer than about three seconds.

HCI_QUIRK_NO_SUSPEND_NOTIFIER stops the disconnect, but it skips
hci_suspend_sync() wholesale, and that leaves Authenticated Payload
Timeout Expired free to end the sleep instead. That event lives in event
mask page 2, which is written once at controller init and which no
suspend path revisits, and it fires auth_payload_timeout after the last
authenticated payload - measured at exactly 655 s with the timeout at its
0xffff maximum, so no amount of tuning reaches past it. The page is
cleared instead; nothing in this driver consumes the event.

Measured on an H96 Max 3518D, single variable each time:

  upstream path       2.8 s   woken by the reconnect advert
  quirk only         28.3 s   woken by the payload timeout at its default
  quirk + this      3598.3 s  woken when the remote drops its own link

Default off, because it changes core suspend behaviour for every user of
the driver; a board opts in through modprobe.d.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 drivers/swtbt4l/skw_btdriver.c | 55 +++++++++++++++++++++-
 1 file changed, 54 insertions(+), 1 deletion(-)

diff --git a/drivers/swtbt4l/skw_btdriver.c b/drivers/swtbt4l/skw_btdriver.c
--- a/drivers/swtbt4l/skw_btdriver.c
+++ b/drivers/swtbt4l/skw_btdriver.c
@@ -32,6 +32,7 @@
 #include <linux/platform_device.h>
 #include <net/bluetooth/bluetooth.h>
 #include <net/bluetooth/hci_core.h>
+#include <linux/suspend.h>
 //#include <linux/platform_data/skw_platform_data.h>
 #include <skw_platform_data.h>
 #include <linux/fs.h>
@@ -107,6 +108,47 @@
 module_param_named(firmware_dir, skwbt_firmware_dir, charp, 0644);
 MODULE_PARM_DESC(firmware_dir, "Firmware subdirectory under standard firmware path (e.g. \"seekwave\"). Empty means root directory.");
 
+/* Off by default: it changes core suspend behaviour for every user of the driver, so a board opts
+ * in rather than everyone inheriting it. */
+static bool keep_link_suspended;
+module_param(keep_link_suspended, bool, 0444);
+MODULE_PARM_DESC(keep_link_suspended,
+    "Keep the BLE link across system suspend, so a paired remote that answers the suspend-time "
+    "disconnect with directed advertising cannot wake the host straight back up. Default off.");
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+static struct hci_dev *skwbt_pm_hdev;
+
+/* Authenticated Payload Timeout Expired lives in event mask page 2, written once at controller init
+ * and revisited by no suspend path. Left on it fires `hdev->auth_payload_timeout` after the last
+ * authenticated payload and caps every suspend there - measured at exactly 655 s with the timeout
+ * at its 0xffff maximum, so tuning cannot reach it. Clear the page instead; nothing here consumes
+ * the event, and it is left cleared on resume for the same reason.
+ */
+static const u8 skwbt_evt_mask_page2_off[8] = { 0 };
+
+static int skwbt_pm_notify(struct notifier_block *nb, unsigned long action, void *unused)
+{
+    struct hci_dev *hdev = skwbt_pm_hdev;
+    struct sk_buff *skb;
+
+    if (action != PM_SUSPEND_PREPARE || !hdev)
+        return NOTIFY_DONE;
+
+    skb = hci_cmd_sync(hdev, HCI_OP_SET_EVENT_MASK_PAGE_2,
+                       sizeof(skwbt_evt_mask_page2_off), skwbt_evt_mask_page2_off,
+                       HCI_CMD_TIMEOUT);
+    if (IS_ERR(skb))
+        SKWBT_INFO("clearing event mask page 2 failed: %ld", PTR_ERR(skb));
+    else
+        kfree_skb(skb);
+
+    return NOTIFY_DONE;
+}
+
+static struct notifier_block skwbt_pm_nb = { .notifier_call = skwbt_pm_notify };
+#endif
+
 static char skwbt_board_id[64] = "";
 
 static int skwbt_request_firmware(const struct firmware **fw,
@@ -1058,7 +1100,13 @@
     atomic_set(&hdev->promisc, 0);
 
     //set_bit(HCI_QUIRK_SIMULTANEOUS_DISCOVERY, &hdev->quirks);
-    //set_bit(HCI_QUIRK_NO_SUSPEND_NOTIFIER, &hdev->quirks);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+    if (keep_link_suspended) {
+        set_bit(HCI_QUIRK_NO_SUSPEND_NOTIFIER, &hdev->quirks);
+        skwbt_pm_hdev = hdev;
+        register_pm_notifier(&skwbt_pm_nb);
+    }
+#endif
 
     err = hci_register_dev(hdev);
     if (err < 0)
@@ -1134,6 +1182,11 @@
         hci_free_dev(hdev);
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 16, 0)
+        if (keep_link_suspended) {
+            unregister_pm_notifier(&skwbt_pm_nb);
+            skwbt_pm_hdev = NULL;
+        }
+
         device_init_wakeup(&pdev->dev, false);
 #endif
 
-- 
