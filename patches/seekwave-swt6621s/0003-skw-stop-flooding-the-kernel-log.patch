From 7c3e5a91d84b02f6ac1e73d5b904812fe6a5d370 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Wed, 26 Aug 2026 01:05:00 -0400
Subject: [PATCH] skw: stop flooding the kernel log at error level

Two mechanisms put ordinary driver chatter into the error log.

skw_log() and skw_sdio_log() take a level, test it against the log mask,
then call pr_err() whatever the level was. Every severity wrapper routes
through them, so skw_info() and skw_dbg() print at KERN_ERR. On an idle
station 111 of 155 [SKWSDIO] lines in 42 minutes were "cp fifo status"
from skw_sdio_rx_thread(), an skw_sdio_info() call, and dmesg -l err,warn
listed all of them.

Add a level-aware form and route each wrapper to its matching printk.
The mask test is unchanged, so /proc/skwifid/log_level still selects
exactly the same messages; only their severity changes. SKW_DETAIL maps
to pr_debug alongside SKW_DEBUG, having no printk level of its own.

That leaves skw_log() and skw_sdio_log() serving only the category masks
called directly from the source - STATE, TIMER, SCAN, CMD, EVENT, DFS,
WORK and the port logs. Those are diagnostics, not failures, so they go
to pr_info. An association state machine printing NONE -> AUTHING ->
AUTHED at KERN_ERR is the visible case.

Two calls are then mislabelled at the source. skw_sdio_rx_thread() logs
"cp fifo status" at info on the path where the FIFO has not moved and
there is nothing to do - the same text and values the dbg call four lines
above already prints unconditionally. It ran 216 times an hour on an idle
station. And eight calls print "the ---debug---line:%d" at info. Both go
to dbg.

skw_hex_dump() takes a "force" flag that skips the SKW_DUMP check:

	if ((skw_log_level() & SKW_DUMP) || force)

Five per-packet sites passed true, so they dumped regardless of the
setting. 1659 of 1678 driver lines over two days were "short skb" from
skw_ndo_start_xmit() while log_level reported "dump log: disable". Pass
false so the existing control applies; the dumps remain available by
enabling dump logging. Sites left alone are bounded: one at wiphy init
and three reached only from private ioctls.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
--- a/drivers/seekwaveplatform_lite/sdio/skw_sdio_log.h
+++ b/drivers/seekwaveplatform_lite/sdio/skw_sdio_log.h
@@ -33,29 +33,35 @@
 #define skw_sdio_log(level, fmt, ...) \
 	do { \
 		if (skw_sdio_log_level() & level) \
-			pr_err(fmt,  ##__VA_ARGS__); \
+			pr_info(fmt,  ##__VA_ARGS__); \
 	} while (0)
 
 #define skw_sdio_port_log(port_num, fmt, ...) \
 	do { \
 		if (skw_sdio_log_level() &(SKW_SDIO_PORT0<<port_num)) \
-			pr_err(fmt,  ##__VA_ARGS__); \
+			pr_info(fmt,  ##__VA_ARGS__); \
 	} while (0)
 
 #define skw_port_log(port_num,fmt, ...) \
 	skw_sdio_log((SKW_SDIO_PORT0<<port_num), "[PORT_LOG] %s: "fmt, __func__, ##__VA_ARGS__)
 
+#define skw_sdio_log_at(pr_fn, level, fmt, ...) \
+	do { \
+		if (skw_sdio_log_level() & level) \
+			pr_fn(fmt,  ##__VA_ARGS__); \
+	} while (0)
+
 #define skw_sdio_err(fmt, ...) \
-	skw_sdio_log(SKW_SDIO_ERROR, "[SKWSDIO ERROR] %s: "fmt, __func__, ##__VA_ARGS__)
+	skw_sdio_log_at(pr_err, SKW_SDIO_ERROR, "[SKWSDIO ERROR] %s: "fmt, __func__, ##__VA_ARGS__)
 
 #define skw_sdio_warn(fmt, ...) \
-	skw_sdio_log(SKW_SDIO_WARNING, "[SKWSDIO WARN] %s: "fmt, __func__, ##__VA_ARGS__)
+	skw_sdio_log_at(pr_warn, SKW_SDIO_WARNING, "[SKWSDIO WARN] %s: "fmt, __func__, ##__VA_ARGS__)
 
 #define skw_sdio_info(fmt, ...) \
-	skw_sdio_log(SKW_SDIO_INFO, "[SKWSDIO INFO] %s: "fmt, __func__, ##__VA_ARGS__)
+	skw_sdio_log_at(pr_info, SKW_SDIO_INFO, "[SKWSDIO INFO] %s: "fmt, __func__, ##__VA_ARGS__)
 
 #define skw_sdio_dbg(fmt, ...) \
-	skw_sdio_log(SKW_SDIO_DEBUG, "[SKWSDIO DBG] %s: "fmt, __func__, ##__VA_ARGS__)
+	skw_sdio_log_at(pr_debug, SKW_SDIO_DEBUG, "[SKWSDIO DBG] %s: "fmt, __func__, ##__VA_ARGS__)
 
 #define skw_sdio_hex_dump(prefix, buf, len) \
 	do { \
