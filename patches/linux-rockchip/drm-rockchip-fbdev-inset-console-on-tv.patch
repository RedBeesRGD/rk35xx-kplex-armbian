From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sun, 21 Sep 2026 00:00:00 +0000
Subject: [PATCH] drm/rockchip: inset the fbdev console on a TV connector

A television overscans. On composite the outer edges of a full-size console
are simply not on the tube, which costs the first and last columns of every
line and the top and bottom rows entirely.

The VP's overscan margins would fix it, but they drive a post-scaler:
left_margin 90 downscales the whole composited frame by 0.9 into a smaller
active window. That is CRTC state, so it applies to every client on the
video port - a KMS client wanting an exact 1:1 plane would silently get a
filtered, non-integer downscale.

Do it in the fbdev layer instead. Lay fbcon out smaller and start it
part-way into the buffer, leaving xres_virtual and fix.line_length at the
full framebuffer so a console row still steps one whole scanline. The plane
scans the entire mode out 1:1 and nothing is scaled; a client that allocates
its own buffers never sees any of this.

Which display the console is on comes from the client's probed modesets, not
from connector status: a TV encoder has no detect line and always reads
connected, so a status test insets an HDMI console as well.

rockchipdrm.fbdev_tv_margin=100 turns it off; 50..99 tunes it.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_fbdev.c b/drivers/gpu/drm/rockchip/rockchip_drm_fbdev.c
index 6f5aca5f0..3278848ff 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_fbdev.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_fbdev.c
@@ -4,7 +4,11 @@
  * Author:Mark Yao <mark.yao@rock-chips.com>
  */
 
+#include <linux/moduleparam.h>
+
 #include <drm/drm.h>
+#include <drm/drm_client.h>
+#include <drm/drm_crtc.h>
 #include <drm/drm_fb_helper.h>
 #include <drm/drm_fourcc.h>
 #include <drm/drm_probe_helper.h>
@@ -16,6 +20,48 @@
 
 #define PREFERRED_BPP		32
 
+static unsigned int fbdev_tv_margin = 80;
+module_param(fbdev_tv_margin, uint, 0444);
+MODULE_PARM_DESC(fbdev_tv_margin,
+		 "percent of a TV connector's mode the console occupies (100 disables)");
+
+/*
+ * A television overscans, so the edges of a full-size console are not on the
+ * tube at all. Lay fbcon out smaller and start it part-way into the buffer: the
+ * plane still scans the whole mode out 1:1, so nothing is scaled, and a KMS
+ * client that allocates its own buffers never sees this.
+ *
+ * What matters is where the console is actually displayed, which the client's
+ * probed modesets answer directly. A connector-status test cannot: a TV encoder
+ * has no detect line and always reads connected, so it would inset an HDMI
+ * console too.
+ */
+static bool rockchip_fbdev_console_on_tv(struct drm_fb_helper *helper)
+{
+	struct drm_mode_set *modeset;
+	bool tv_only = false;
+	unsigned int i;
+
+	if (fbdev_tv_margin >= 100 || fbdev_tv_margin < 50)
+		return false;
+
+	mutex_lock(&helper->client.modeset_mutex);
+	drm_client_for_each_modeset(modeset, &helper->client) {
+		for (i = 0; i < modeset->num_connectors; i++) {
+			if (modeset->connectors[i]->connector_type !=
+			    DRM_MODE_CONNECTOR_TV) {
+				tv_only = false;
+				goto out;
+			}
+			tv_only = true;
+		}
+	}
+out:
+	mutex_unlock(&helper->client.modeset_mutex);
+
+	return tv_only;
+}
+
 static int rockchip_fbdev_mmap(struct fb_info *info,
 			       struct vm_area_struct *vma)
 {
@@ -88,6 +134,24 @@ static int rockchip_drm_fbdev_create(struct drm_fb_helper *helper,
 	offset = fbi->var.xoffset * bytes_per_pixel;
 	offset += fbi->var.yoffset * fb->pitches[0];
 
+	if (rockchip_fbdev_console_on_tv(helper)) {
+		unsigned int w = (fbi->var.xres * fbdev_tv_margin / 100) & ~1U;
+		unsigned int h = (fbi->var.yres * fbdev_tv_margin / 100) & ~1U;
+
+		offset += ((fbi->var.yres - h) / 2) * fb->pitches[0];
+		offset += ((fbi->var.xres - w) / 2) * bytes_per_pixel;
+
+		/* xres_virtual and fix.line_length stay at the full framebuffer,
+		 * so a console row still steps one whole scanline of it -
+		 * drm_fb_helper_check_var() resets them on set_par regardless.
+		 */
+		fbi->var.xres = w;
+		fbi->var.yres = h;
+
+		DRM_DEV_INFO(dev->dev, "console inset to %ux%u for the TV connector\n",
+			     w, h);
+	}
+
 	dev->mode_config.fb_base = 0;
 	fbi->screen_base = rk_obj->kvaddr + offset;
 	fbi->screen_size = rk_obj->base.size;
